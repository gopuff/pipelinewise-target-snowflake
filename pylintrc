[MAIN]
jobs=1
persistent=no
ignore=
extension-pkg-whitelist=ujson

[MESSAGES CONTROL]
# Keep historical disables from the legacy pylintrc, plus checks that are
# noisy for this singer target codebase / newer pylint versions.
disable=
    wrong-import-order,
    broad-exception-caught,
    broad-exception-raised,
    missing-module-docstring,
    missing-class-docstring,
    missing-function-docstring,
    duplicate-code,
    too-many-arguments,
    too-many-positional-arguments,
    too-many-locals,
    too-many-branches,
    too-many-statements,
    too-few-public-methods,
    invalid-name,
    unnecessary-lambda-assignment,
    fixme

[REPORTS]
output-format=text
reports=no
score=yes

[BASIC]
good-names=i,j,k,ex,Run,_,id,db

[FORMAT]
max-line-length=120

[DESIGN]
max-args=10
max-locals=25
max-branches=20
max-statements=60

[EXCEPTIONS]
overgeneral-exceptions=builtins.Exception
